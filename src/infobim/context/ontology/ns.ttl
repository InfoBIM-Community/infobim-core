@prefix ibim: <https://infobim.org/ontology/ns#> .
@prefix ifcowl: <https://standards.buildingsmart.org/IFC/DEV/IFC4_3/OWL#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ns.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ibim:IfcWorkSchedule
    a owl:Class, obdc:SurfaceableEntity ;
    rdfs:subClassOf obdc:DataEntity, ifcowl:IfcWorkSchedule ;
    ibim:assignsRelatedClass ifcowl:IfcTask, ifcowl:IfcTaskTime ;
    rdfs:label "IFC Work Schedule"@en, "Cronograma IFC"@pt-BR .

ibim:assignsRelatedClass
    a owl:ObjectProperty ;
    rdfs:domain owl:Class ;
    rdfs:range owl:Class ;
    rdfs:comment "Declares a class in the operational context without prescribing its physical representation."@en .
