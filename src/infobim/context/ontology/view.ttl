#################################################################
# SHACL baseline
#################################################################

ibim:FacadeShape
    a sh:NodeShape ;
    sh:targetClass ibim:Facade ;
    sh:property [ sh:path ibim:hasFacadeField ; sh:class ibim:FacadeField ; sh:minCount 1 ] ;
    sh:property [ sh:path ibim:targetsClass ; sh:maxCount 1 ] .

ibim:FacadeFieldShape
    a sh:NodeShape ;
    sh:targetClass ibim:FacadeField ;
    sh:property [ sh:path ibim:defaultProperty ; sh:maxCount 1 ] ;
    sh:property [ sh:path ibim:fieldDatatype ; sh:maxCount 1 ] ;
    sh:property [ sh:path ibim:fieldOrder ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ibim:isIdentifierField ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .
